{
  "name": "Формы и макеты meta-edit не регистрирует — отсылает к form-add/template-add",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Контрагенты"
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    }
  ],
  "params": {
    "objectPath": "Catalogs/Контрагенты"
  },
  "input": {
    "add": {
      "forms": [
        "ФормаЭлемента"
      ],
      "templates": [
        "ПечатнаяФорма"
      ]
    }
  },
  "expect": {
    "fileNotContains": [
      {
        "file": "Catalogs/Контрагенты.xml",
        "text": [
          "<Form",
          "<Template"
        ]
      }
    ]
  },
  "expectError": "form-add"
}
